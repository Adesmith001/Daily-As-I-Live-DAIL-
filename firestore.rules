rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validTheme(theme) {
      return theme in ['Mist', 'Sage', 'Sky', 'Peach', 'Lilac', 'Rose', 'Sand', 'Slate'];
    }

    function validDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validTracker(data, trackerId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'sectionId',
          'type',
          'description',
          'isActive',
          'displayOrder',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == trackerId &&
        data.userId == request.auth.uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 4096 &&
        (
          !data.keys().hasAny(['sectionId']) ||
          data.sectionId == null ||
          (data.sectionId is string && data.sectionId.size() > 0 && data.sectionId.size() <= 120)
        ) &&
        data.type in ['checkbox', 'range'] &&
        data.description is string &&
        data.description.size() <= 140 &&
        data.isActive is bool &&
        data.displayOrder is int;
    }

    function validTrackerSection(data, sectionId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'displayOrder',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == sectionId &&
        data.userId == request.auth.uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.displayOrder is int;
    }

    function validEntry(data, entryId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'trackerId',
          'entryDate',
          'checkboxValue',
          'rangeValue',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == entryId &&
        data.userId == request.auth.uid &&
        data.trackerId is string &&
        validDate(data.entryDate) &&
        (
          (data.checkboxValue is bool && data.rangeValue == null) ||
          (data.rangeValue is int && data.rangeValue >= 0 && data.rangeValue <= 10 && data.checkboxValue == null)
        );
    }

    function validExerciseWeekday(weekday) {
      return weekday in [
        'monday',
        'tuesday',
        'wednesday',
        'thursday',
        'friday',
        'saturday',
        'sunday'
      ];
    }

    function validExerciseCategory(category) {
      return category in [
        'warmup',
        'workout',
        'cardio',
        'core',
        'mobility',
        'recovery',
        'full-body'
      ];
    }

    function validExerciseWorkout(data, workoutId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'templateItemId',
          'name',
          'weekday',
          'weekdayOrder',
          'category',
          'description',
          'target',
          'videoUrl',
          'videoSearchQuery',
          'isActive',
          'displayOrder',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == workoutId &&
        data.userId == request.auth.uid &&
        (
          !data.keys().hasAny(['templateItemId']) ||
          data.templateItemId == null ||
          (data.templateItemId is string && data.templateItemId.size() > 0 && data.templateItemId.size() <= 120)
        ) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 240 &&
        validExerciseWeekday(data.weekday) &&
        data.weekdayOrder is int &&
        data.weekdayOrder >= 0 &&
        data.weekdayOrder <= 6 &&
        validExerciseCategory(data.category) &&
        data.description is string &&
        data.description.size() <= 240 &&
        data.target is string &&
        data.target.size() > 0 &&
        data.target.size() <= 140 &&
        data.videoUrl is string &&
        data.videoUrl.size() <= 2048 &&
        data.videoSearchQuery is string &&
        data.videoSearchQuery.size() <= 200 &&
        data.isActive is bool &&
        data.displayOrder is int;
    }

    function validExerciseEntry(data, entryId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'workoutId',
          'entryDate',
          'isCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == entryId &&
        data.userId == request.auth.uid &&
        data.workoutId is string &&
        validDate(data.entryDate) &&
        data.isCompleted is bool;
    }

    function validExerciseProfile(data, profileId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'xpTotal',
          'currentStreak',
          'bestStreak',
          'weeklyAdherence',
          'badges',
          'defaultTemplateVersionImported',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == profileId &&
        data.userId == request.auth.uid &&
        data.xpTotal is int &&
        data.xpTotal >= 0 &&
        data.currentStreak is int &&
        data.currentStreak >= 0 &&
        data.bestStreak is int &&
        data.bestStreak >= 0 &&
        data.weeklyAdherence is number &&
        data.weeklyAdherence >= 0 &&
        data.weeklyAdherence <= 100 &&
        data.badges is list &&
        data.badges.size() <= 20 &&
        (
          data.defaultTemplateVersionImported == null ||
          (data.defaultTemplateVersionImported is string &&
            data.defaultTemplateVersionImported.size() <= 120)
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'theme',
          'createdAt'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        validTheme(request.resource.data.theme);
      allow update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'theme',
          'createdAt'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.displayName is string &&
        validTheme(request.resource.data.theme);
      allow delete: if false;
    }

    match /trackers/{trackerId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validTracker(request.resource.data, trackerId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validTracker(request.resource.data, trackerId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /trackerSections/{sectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validTrackerSection(request.resource.data, sectionId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validTrackerSection(request.resource.data, sectionId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /dailyEntries/{entryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validEntry(request.resource.data, entryId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validEntry(request.resource.data, entryId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /exerciseWorkouts/{workoutId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validExerciseWorkout(request.resource.data, workoutId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validExerciseWorkout(request.resource.data, workoutId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /exerciseEntries/{entryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validExerciseEntry(request.resource.data, entryId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validExerciseEntry(request.resource.data, entryId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /exerciseProfiles/{profileId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validExerciseProfile(request.resource.data, profileId);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validExerciseProfile(request.resource.data, profileId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
